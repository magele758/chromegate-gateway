{
  "manifest_version": 3,
  "name": "ChromeGate",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Per-agent token gate so local MCP clients can drive the signed-in Chrome with an audit log.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChromeGate",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "scripting", "debugger", "nativeMessaging", "alarms"],
  "optional_permissions": ["userScripts"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
